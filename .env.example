# Copy this file to .env.local and fill in real values.
# Vars prefixed NEXT_PUBLIC_ are bundled into client JS and visible to
# anyone — never put a secret behind that prefix.

# --- Firebase Auth (client-side, safe to be public) ---
# https://console.firebase.google.com -> Project settings -> General -> Your apps
NEXT_PUBLIC_API_KEY=
NEXT_PUBLIC_AUTH_DOMAIN=
NEXT_PUBLIC_PROJECT_ID=
NEXT_PUBLIC_STORAGE_BUCKET=
NEXT_PUBLIC_MESSAGING_SENDER_ID=
NEXT_PUBLIC_APP_ID=
NEXT_PUBLIC_MEASUREMENT_ID=

# --- Sanity (project/dataset identifiers, safe to be public) ---
# https://www.sanity.io/manage -> select project -> API
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=
NEXT_PUBLIC_SANITY_API_VERSION=2023-09-15

# --- Sanity (secret — server-only, used by app/api/sanity/documents) ---
# Create a token with "Editor" (or Deploy Studio) permissions under
# https://www.sanity.io/manage -> select project -> API -> Tokens
# Do NOT prefix this with NEXT_PUBLIC_.
SANITY_API_WRITE_TOKEN=

# --- App database (secret — server-only, used by lib/db and drizzle.config.ts) ---
# Neon connection string, pooled endpoint (console.neon.tech -> Connect to
# your database -> keep "Connection pooling" on).
DATABASE_URL=

# --- Third-party APIs ---
# https://www.exchangerate-api.com — used by /utilities/currency-converter
NEXT_PUBLIC_EXCHANGE_RATE_API_KEY=

# --- Content sourcing (optional, only used by `npm run seed:source`) ---
# https://unsplash.com/developers — free tier. If unset, the seed script
# falls back to each destination's Wikipedia image and establishments are
# sourced without photos.
UNSPLASH_ACCESS_KEY=
